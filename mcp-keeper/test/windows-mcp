// Stands in for windows-mcp in the tests (no extension, so node --test does not run it): with
// "serve --transport streamable-http --host 127.0.0.1 --port <n>" it answers HTTP on that port and
// reports FAKE_TOKEN, so the test sees the original entry's env reached the server.
const http = require("node:http");

const args = process.argv.slice(2);
const at = args.indexOf("--port");
if (args[0] !== "serve" || !args.includes("streamable-http") || at < 0) process.exit(3);
http
  .createServer((_, res) => res.end(JSON.stringify({ pid: process.pid, token: process.env.FAKE_TOKEN ?? null })))
  .listen(Number(args[at + 1]), "127.0.0.1");
